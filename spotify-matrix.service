[Unit]
Description=Spotify LED matrix display
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/probsyash/spotify-matrix
Environment=PYTHONUNBUFFERED=1
Environment=BROWSER=echo
ExecStart=/home/probsyash/spotify-matrix/.venv/bin/python /home/probsyash/spotify-matrix/spotify_matrix.py --rows 64 --cols 64 --chain-length 1 --parallel 1 --gpio-slowdown 4 --no-hardware-pulse --hardware-mapping adafruit-hat
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
